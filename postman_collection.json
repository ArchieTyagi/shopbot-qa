{
  "info": {
    "name": "ShopBot API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"username\": \"archi\", \"password\": \"test123\"}" },
        "url": "http://127.0.0.1:8000/login"
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('Status is 200', () => pm.response.to.have.status(200));",
          "pm.test('Has token', () => pm.expect(pm.response.json()).to.have.property('token'));"
        ]}
      }]
    },
    {
      "name": "Get all products",
      "request": { "method": "GET", "url": "http://127.0.0.1:8000/products" },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('Status is 200', () => pm.response.to.have.status(200));",
          "pm.test('3 products', () => pm.expect(pm.response.json().length).to.eql(3));"
        ]}
      }]
    },
    {
      "name": "Place order",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer token-archi-123" }
        ],
        "body": { "mode": "raw", "raw": "{\"product_id\": 1, \"quantity\": 1}" },
        "url": "http://127.0.0.1:8000/orders"
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('Status is 201', () => pm.response.to.have.status(201));"
        ]}
      }]
    },
    {
      "name": "Chat with bot",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"message\": \"What is the price of keyboard?\"}" },
        "url": "http://127.0.0.1:8000/chat"
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('Mentions price', () => pm.expect(pm.response.json().reply).to.include('1499'));"
        ]}
      }]
    }
  ]
}
